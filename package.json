{
  "name": "pi-goimports",
  "version": "0.1.0",
  "description": "pi extension — run goimports on write/edit of *.go files and inject the diff into the tool result",
  "keywords": ["pi-package"],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huww98/pi-goimports.git"
  },
  "pi": {
    "extensions": ["./goimports.ts"]
  },
  "files": [
    "goimports.ts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22",
    "typescript": "^5.9"
  }
}

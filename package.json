{
  "name": "pi-goimports",
  "version": "0.2.1",
  "description": "pi extension — run goimports on write/edit of *.go files and inject the diff into the tool result",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huww98/pi-goimports.git"
  },
  "pi": {
    "extensions": [
      "./goimports.ts"
    ]
  },
  "files": [
    "goimports.ts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22",
    "typescript": "^5.9"
  }
}
